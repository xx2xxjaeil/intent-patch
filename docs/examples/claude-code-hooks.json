{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/node_modules/intentpatch/dist/presentation/cli/main.js",
              "claude-hook",
              "capture"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/node_modules/intentpatch/dist/presentation/cli/main.js",
              "claude-hook",
              "analyze"
            ]
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/node_modules/intentpatch/dist/presentation/cli/main.js",
              "claude-hook",
              "clear"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/node_modules/intentpatch/dist/presentation/cli/main.js",
              "claude-hook",
              "clear"
            ]
          }
        ]
      }
    ]
  }
}
