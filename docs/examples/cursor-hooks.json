{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node \"/absolute/path/to/intent-patch/dist/presentation/cli/main.js\" cursor-hook capture",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "node \"/absolute/path/to/intent-patch/dist/presentation/cli/main.js\" cursor-hook analyze",
        "timeout": 30
      }
    ]
  }
}
